  "vectors": [
    {"input": "",                                 "parsed": {"field_names": [], "wildcard": false}, "serialize": "",                            "source": "RFC 9110 \u00a712.5.5 \u00b65 (empty value, not wildcard)"},
    {"input": "*",                                "parsed": {"field_names": [], "wildcard": true},  "serialize": "*",                            "source": "RFC 9110 \u00a712.5.5 \u00b64 (wildcard member)"},
    {"input": "Accept",                           "parsed": {"field_names": ["Accept"], "wildcard": false}, "serialize": "Accept",                  "source": "RFC 9110 \u00a712.5.5 \u00b65 (single selecting field)"},
    {"input": "accept-encoding, accept-language", "parsed": {"field_names": ["accept-encoding", "accept-language"], "wildcard": false}, "serialize": "accept-encoding, accept-language", "source": "RFC 9110 \u00a712.5.5 \u00b65 (canonical example verbatim)"},
    {"input": "  Accept-Encoding  ,\tUser-Agent  ", "parsed": {"field_names": ["Accept-Encoding", "User-Agent"], "wildcard": false}, "serialize": "Accept-Encoding, User-Agent", "source": "RFC 9110 \u00a75.6.3 OWS tolerance test"},
    {"input": "*, Accept",                        "parsed": {"field_names": [], "wildcard": true},  "serialize": "*",                            "source": "RFC 9110 \u00a712.5.5 \u00b64 (wildcard takes precedence; field names dropped)"},
    {"input": "X-Custom-Flag, Accept-Language, x-other", "parsed": {"field_names": ["X-Custom-Flag", "Accept-Language", "x-other"], "wildcard": false}, "serialize": "X-Custom-Flag, Accept-Language, x-other", "source": "RFC 9110 \u00a75.6.2 (case-preserving; case-insensitive comparison is consumer's job)"},
    {"input": "Accept,,User-Agent",               "parsed": {"field_names": ["Accept", "User-Agent"], "wildcard": false}, "serialize": "Accept, User-Agent",       "source": "RFC 9110 \u00a75.6.1 (empty list entries silently dropped, robust-parsing convention)"},
    {"input": "A, B, C",                          "parsed": {"field_names": ["A", "B", "C"], "wildcard": false}, "serialize": "A, B, C",                "source": "RFC 9110 \u00a75.6.2 (single-char tokens are valid per tchar ABNF)"},
    {"input": ",,",                               "parsed": {"field_names": [], "wildcard": false}, "serialize": "",                            "source": "RFC 9110 \u00a712.5.5 (empty list, not wildcard)"}
  ],
  "cache_key_examples": [
