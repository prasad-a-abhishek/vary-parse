{
  "algorithm": "RFC 9110 \u00a712.5.5 HTTP Vary response header field parser",
  "spec_authority": "IETF RFC 9110 'HTTP Semantics' (June 2022), \u00a712.5.5 + Appendix B.2 ABNF; companion RFC 9111 \u00a74.1 (cache-key construction)",
  "abnf": "Vary = [ ( \"*\" / field-name ) *( OWS \",\" OWS ( \"*\" / field-name ) ) ]",
  "primary_sources": [
